<?xml version="1.0" encoding="utf-8"?>
<!--
  An Atom 1.0 feed, and to kiln just another page: an ordinary entry in
  target.pages, laid out from the same posts list, cached and cleaned like
  any other output. Its "absolute-urls": true is the one thing a feed needs,
  being read on someone else's domain. Titles and bodies go in CDATA so no
  markup in them can break the XML.
-->
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>Kiln Example Site</title>
    <subtitle>Plain text, long-term archives, and quiet publishing.</subtitle>
    <id>$site-url$$webroot$</id>
    <link rel="alternate" type="text/html" href="$site-url$$webroot$" />
    <link rel="self" type="application/atom+xml" href="$site-url$$webroot$atom.xml" />
    <author>
        <name>Kiln Example Site</name>
    </author>
    <generator>kiln</generator>
    <!-- The feed's timestamp is the newest post's: posts is sorted newest
         first, so that is the one marked first. Posts carry a date and no
         time, hence midnight. -->
$for(posts)$$if(posts.first)$    <updated>$posts.date$T00:00:00Z</updated>
$endif$$endfor$
$for(posts)$
    <entry>
        <title type="html"><![CDATA[$posts.title$]]></title>
        <id>$posts.url$</id>
        <link rel="alternate" type="text/html" href="$posts.url$" />
        <updated>$posts.date$T00:00:00Z</updated>
        <!-- A feed carries the whole article, and `content` starts where
             `abstract` ends, so both go here in the page's own order. -->
        <content type="html"><![CDATA[$posts.abstract$
$posts.content$]]></content>
    </entry>
$endfor$
</feed>
